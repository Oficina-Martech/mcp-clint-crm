{
  "name": "@oficina-martech/mcp-clint-crm",
  "version": "0.1.0",
  "description": "MCP server for Clint CRM API — 47 tools: contacts, deals, organizations, tags, users, origins, groups, lost-status, channel accounts, message templates, chats, messages, dashboards",
  "license": "MIT",
  "author": "Oficina Martech <oficinamartech@gmail.com>",
  "homepage": "https://github.com/Oficina-Martech/mcp-clint-crm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oficina-Martech/mcp-clint-crm.git"
  },
  "bugs": {
    "url": "https://github.com/Oficina-Martech/mcp-clint-crm/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-clint-crm": "dist/index.js"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && chmod +x dist/index.js",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "clint",
    "clint-crm",
    "crm",
    "whatsapp",
    "model-context-protocol",
    "claude"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
